# Backend environment variables. Copy to .env and fill in the blanks.
# Startup fails with a message naming any required value that is missing.

# --- Server (optional) ---
PORT=3001
# A browser origin allowed to call the API besides the API's own (the Vite dev server, say).
# The origin the API is served on always passes, so the Compose stack leaves this unset.
CORS_ORIGIN=https://your-frontend-domain.example

# --- Database (DB_USER, DB_PASSWORD, DB_NAME required) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=tempuser
DB_PASSWORD=your_secure_password_here
DB_NAME=temperature_alarms

# --- Shared secrets (both required; see docs/adr/0003) ---
# Admin token: sent by the Settings page on every change to Campuses, Devices, and history.
ADMIN_TOKEN=change-me-admin
# Device token: sent by every Device with each Reading. Rotating it means reflashing every Device.
DEVICE_TOKEN=change-me-device
# Only during a rotation: the old Device token, still accepted until every board is reflashed
# with the new DEVICE_TOKEN; clear it then. Must differ from both tokens above.
# DEVICE_TOKEN_PREVIOUS=

# --- Behaviour (optional, defaults shown) ---
# How often a healthy Device reports. Offline is declared after three missed intervals.
REPORT_INTERVAL_SECONDS=30
# How many days of raw Readings to keep (docs/adr/0004).
RETENTION_DAYS=90
# Where Conditions begin (whole numbers). Mold risk is a fixed rule and has no knob.
HOT_WARNING_F=82
HOT_CRITICAL_F=90
COLD_WARNING_F=50
DRY_WARNING_PERCENT=20
MISSED_REPORTS_BEFORE_OFFLINE=3
# The server's zone, an IANA name, if not the system's: quiet hours, the times in emails, and the monthly
# report's months are read in it. Node reads it at startup; an unknown one stops the backend.
# TZ=America/Chicago

# --- Email notifications (optional; off while SMTP_HOST is unset, docs/adr/0008) ---
# With SMTP_HOST set, NOTIFY_FROM, NOTIFY_TO, and PUBLIC_URL are required too, and startup
# refuses a half-set group. Settings, Notifications, has a "Send test email" button.
# The district's SMTP relay.
# SMTP_HOST=relay.district.example
# 587 by default, 465 with SMTP_SECURE=tls.
# SMTP_PORT=587
# starttls (default; never falls back to plain text), tls (TLS from the first byte), or none.
# SMTP_SECURE=starttls
# Only for a relay that needs a login: both or neither.
# SMTP_USER=
# SMTP_PASSWORD=
# The sender address the relay allows.
# NOTIFY_FROM=temperature-alarms@district.example
# Recipients, comma-separated; a distribution list keeps who receives alerts out of this file.
# The default: a Campus can name its own recipients on Settings, and one without them emails these.
# NOTIFY_TO=network-techs@district.example
# The address technicians open the dashboard at, for links in emails.
# PUBLIC_URL=https://temperature-alarms.district.example
# How long to gather Incident changes into one email.
# NOTIFY_COALESCE_SECONDS=60
# Email an Incident again once it has been open this many hours unacknowledged, then every as many
# hours after, until it closes or someone acknowledges it. Empty or 0: no reminders; at most 168.
# NOTIFY_REMIND_HOURS=4
# true: NOTIFY_TO also gets every email sent to a Campus's own recipients (a district office that
# wants all of it). Empty or false: only the Campus's own.
# NOTIFY_TO_ALL=true
# true: email NOTIFY_TO a report on the month just ended on the 1st of each month. Empty or false: off.
# NOTIFY_MONTHLY_REPORT=true
# Quiet hours: warning emails wait while they last (two 24-hour times in the server's zone, the end before
# the start past midnight) and, with NOTIFY_QUIET_WEEKENDS=true, all weekend. Empty: none.
# NOTIFY_QUIET_HOURS=18:00-07:00
# NOTIFY_QUIET_WEEKENDS=true

# --- Tests only ---
# Where `npm test` finds MySQL. Defaults to the Docker Compose database (`npm run test:db`).
# TEST_DATABASE_URL=mysql://temp:temp@127.0.0.1:3307/temperature_alarms_test
