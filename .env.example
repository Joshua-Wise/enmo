# Settings for the Docker Compose stack (compose.yaml). Copy to .env and fill in the four
# secrets; `docker compose up` refuses to start naming any that is unset. Generate each with:
#   openssl rand -hex 32
# deploy/deploy.sh install (or deploy.ps1 install) does all of this for you.

# --- Required ---
# Sent by the Settings page on every change to Campuses, Devices, and history (docs/adr/0003).
ADMIN_TOKEN=
# Sent by every Device with each Reading; goes into each board's config.h, so rotating it
# means reflashing every Device (deploy.sh rotate-device-token keeps the old one working meanwhile).
DEVICE_TOKEN=
# Password of the database user api connects as. The database is never published outside the stack.
DB_PASSWORD=
# Password of MySQL root, for backups and restores through `docker compose exec db`. Only the
# db container has it; api never does. MySQL takes it when the database volume is first created.
DB_ROOT_PASSWORD=

# --- Set only during a Device token rotation ---
# The Device token being retired, still accepted until every board is reflashed with the new
# DEVICE_TOKEN. deploy.sh rotate-device-token sets it, and --finish clears it (docs/adr/0003).
DEVICE_TOKEN_PREVIOUS=

# --- Optional, defaults shown ---
# The one published port: the dashboard and /api/ on http://<host>:WEB_PORT. With a TLS
# proxy on the host in front (DEPLOYMENT.md), prefix an address to keep the port off the
# network: WEB_PORT=127.0.0.1:8080
WEB_PORT=80
# Behind a TLS proxy (DEPLOYMENT.md, TLS in front of the stack): the proxy's address(es),
# comma-separated, or `gateway` for a proxy on this host. Empty: no proxy in front.
TRUST_PROXY=
# How often a healthy Device reports. Offline is declared after three missed intervals.
REPORT_INTERVAL_SECONDS=30
# How many days of raw Readings to keep (docs/adr/0004).
RETENTION_DAYS=90
# Where Conditions begin (whole numbers). Mold risk is a fixed rule and has no knob.
HOT_WARNING_F=82
HOT_CRITICAL_F=90
COLD_WARNING_F=50
DRY_WARNING_PERCENT=20
MISSED_REPORTS_BEFORE_OFFLINE=3
# The api's time zone, an IANA name: quiet hours (NOTIFY_QUIET_HOURS), the times in emails, and the
# monthly report's months are read in it. Empty: UTC, the container's own. An unknown zone stops api
# from starting, naming it (--set TZ=America/Chicago).
# TZ=America/Chicago
# MySQL's InnoDB buffer pool (MySQL size syntax: 512M, 1G). 512M keeps a week of 100 Devices'
# Readings in memory for the Campuses overview; use 1G from 300 Devices, on a CT with 4 GiB
# (DEPLOYMENT.md, Database settings and sizing). MySQL uses about this plus 400 MiB.
DB_BUFFER_POOL_SIZE=512M

# --- Email notifications (optional; off while SMTP_HOST is unset, docs/adr/0008) ---
# deploy.sh install asks for these (--smtp-host and friends without asking; DEPLOYMENT.md, Email
# notifications). With SMTP_HOST set, NOTIFY_FROM, NOTIFY_TO, and PUBLIC_URL are required too, and
# api refuses to start on a half-set group, or on any of them set without SMTP_HOST.
# The district's SMTP relay.
# SMTP_HOST=relay.example.org
# 587 by default, 465 with SMTP_SECURE=tls; 25 for a relay that takes plain SMTP.
# SMTP_PORT=587
# starttls (default; never falls back to plain text), tls (TLS from the first byte), or none.
# SMTP_SECURE=starttls
# Only for a relay that needs a login: both or neither. Keep the password in single quotes, so a
# $ or # in it is read as itself; deploy.sh writes it that way.
# SMTP_USER=
# SMTP_PASSWORD=
# The sender address the relay allows.
# NOTIFY_FROM=temperature-alarms@example.org
# Recipients, comma-separated; a distribution list keeps who receives alerts out of this file.
# The default: a Campus can name its own recipients on Settings, and one without them emails these.
# NOTIFY_TO=network-techs@example.org
# The address technicians open the dashboard at, for links in emails.
# PUBLIC_URL=https://YOUR_DOMAIN
# How long to gather Incident changes into one email, in seconds.
# NOTIFY_COALESCE_SECONDS=60
# Email an Incident again once it has been open this many hours with no one acknowledging it, then
# every as many hours after, until it closes or someone does. Empty or 0: no reminders (the
# default); at most 168. deploy.sh install offers 4 (--notify-remind-hours).
# NOTIFY_REMIND_HOURS=4
# true: NOTIFY_TO also gets every email sent to a Campus's own recipients (a district office that
# wants all of it). Empty or false: only the Campus's own (--set NOTIFY_TO_ALL=true).
# NOTIFY_TO_ALL=true
# true: on the 1st of each month, email NOTIFY_TO (never a Campus's own recipients) a report on the
# month just ended (the hottest and most humid closets, incidents and time in each Condition, closets
# that ran warm, Offline and Sensor fault time). Empty or false: off (the default). deploy.sh:
# --notify-monthly-report on|off.
# NOTIFY_MONTHLY_REPORT=true
# Quiet hours: warning emails wait while they last and go out as one email when they end; critical
# Incidents, Offline, and Sensor fault still go at once. Two 24-hour times in TZ, the end before the
# start for a window past midnight. Empty: none (the default). deploy.sh: --notify-quiet-hours
# 18:00-07:00 (or off).
# NOTIFY_QUIET_HOURS=18:00-07:00
# true: warning emails also wait all Saturday and Sunday, until Monday (and its quiet hours' end).
# Empty or false: off. deploy.sh: --notify-quiet-weekends on|off.
# NOTIFY_QUIET_WEEKENDS=true
